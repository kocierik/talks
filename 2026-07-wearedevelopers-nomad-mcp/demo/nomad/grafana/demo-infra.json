{
  "uid": "demo-infra-nomad",
  "title": "Demo · Infrastructure (Nomad / node-exporter)",
  "description": "Homelab: two nodes, CPU, RAM, load, root disk, network. Prometheus + node-exporter. Demo folder.",
  "tags": ["demo", "nomad", "node-exporter"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 5,
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "editable": true,
  "graphTooltip": 1,
  "panels": [
    {
      "type": "row",
      "title": "CPU & memory",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 101,
      "collapsed": false
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "CPU % non-idle (by instance)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prom_ds" },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (1 - avg by (instance) (rate(node_cpu_seconds_total{mode=\"idle\",job=\"node-exporter\"}[5m])))",
          "legendFormat": "{{instance}}",
          "datasource": { "type": "prometheus", "uid": "prom_ds" }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 12,
            "showPoints": "never"
          },
          "unit": "percent",
          "min": 0,
          "max": 100
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Memory available %",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prom_ds" },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (node_memory_MemAvailable_bytes{job=\"node-exporter\"} / node_memory_MemTotal_bytes{job=\"node-exporter\"})",
          "legendFormat": "{{instance}}",
          "datasource": { "type": "prometheus", "uid": "prom_ds" }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 10,
            "showPoints": "never"
          },
          "unit": "percent",
          "min": 0,
          "max": 100
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "type": "row",
      "title": "Load, disk, network",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 },
      "id": 102,
      "collapsed": false
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Load average (1m / 5m)",
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 10 },
      "datasource": { "type": "prometheus", "uid": "prom_ds" },
      "targets": [
        {
          "refId": "A",
          "expr": "node_load1{job=\"node-exporter\"}",
          "legendFormat": "{{instance}} load1",
          "datasource": { "type": "prometheus", "uid": "prom_ds" }
        },
        {
          "refId": "B",
          "expr": "node_load5{job=\"node-exporter\"}",
          "legendFormat": "{{instance}} load5",
          "datasource": { "type": "prometheus", "uid": "prom_ds" }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 0,
            "showPoints": "never"
          },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Disk / — used %",
      "description": "100 minus free space on root (ext4/xfs, …)",
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 10 },
      "datasource": { "type": "prometheus", "uid": "prom_ds" },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (1 - node_filesystem_avail_bytes{job=\"node-exporter\",mountpoint=\"/\",fstype!~\"tmpfs|squashfs|fuse.*\"} / node_filesystem_size_bytes{job=\"node-exporter\",mountpoint=\"/\",fstype!~\"tmpfs|squashfs|fuse.*\"})",
          "legendFormat": "{{instance}}",
          "datasource": { "type": "prometheus", "uid": "prom_ds" }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 15,
            "showPoints": "never"
          },
          "unit": "percent",
          "min": 0,
          "max": 100
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Network — receive (bit/s)",
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 17 },
      "datasource": { "type": "prometheus", "uid": "prom_ds" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (instance) (rate(node_network_receive_bytes_total{job=\"node-exporter\",device!~\"lo|veth.*|br-.*|docker0|virbr.*\"}[5m])) * 8",
          "legendFormat": "{{instance}}",
          "datasource": { "type": "prometheus", "uid": "prom_ds" }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 8,
            "showPoints": "never"
          },
          "unit": "bps"
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Network — transmit (bit/s)",
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 17 },
      "datasource": { "type": "prometheus", "uid": "prom_ds" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (instance) (rate(node_network_transmit_bytes_total{job=\"node-exporter\",device!~\"lo|veth.*|br-.*|docker0|virbr.*\"}[5m])) * 8",
          "legendFormat": "{{instance}}",
          "datasource": { "type": "prometheus", "uid": "prom_ds" }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 8,
            "showPoints": "never"
          },
          "unit": "bps"
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "type": "row",
      "title": "Uptime",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 24 },
      "id": 103,
      "collapsed": false
    },
    {
      "id": 9,
      "type": "stat",
      "title": "Uptime (days)",
      "gridPos": { "h": 4, "w": 24, "x": 0, "y": 25 },
      "datasource": { "type": "prometheus", "uid": "prom_ds" },
      "targets": [
        {
          "refId": "A",
          "expr": "(time() - node_boot_time_seconds{job=\"node-exporter\"}) / 86400",
          "legendFormat": "{{instance}}",
          "datasource": { "type": "prometheus", "uid": "prom_ds" }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "d",
          "decimals": 1,
          "thresholds": { "mode": "absolute", "steps": [{ "color": "blue", "value": null }] }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "horizontal",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "value_and_name"
      }
    }
  ],
  "templating": { "list": [] },
  "annotations": { "list": [] }
}